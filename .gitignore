# OS / editor artifacts
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Verification-run scratch caches (regenerated by the scripts; not source).
# NOTE: the d4flex_*_done.cache.json artifacts ARE tracked deliberately (precomputed
# so no verification needs heavy compute) and are re-included below.
*.cache.json
!rigidity/d4flex_*_done.cache.json
# Tower-paper (paper #5) checkpoint caches: shipped so every branch_* script runs from a
# clean clone without hours of recomputation. Heavy intermediates (>3 MB) stay untracked.
!rigidity/d6flex_*.cache.json
!rigidity/d6galois_*.cache.json
!rigidity/d6anchor_*.cache.json
!rigidity/d6tight_*.cache.json
!rigidity/d6geo_*.cache.json
!rigidity/d8galois_*.cache.json
!rigidity/d10_*.cache.json
!rigidity/d8flexcert_*.cache.json
!rigidity/d12flexcert_*.cache.json
!rigidity/d6flexcert_*.cache.json
!rigidity/d6secondorder_*.cache.json
!rigidity/d10flexcert_*.cache.json
!rigidity/x2class_*.cache.json
!rigidity/x2closed_*.cache.json
!rigidity/d12_*.cache.json
!rigidity/m9geo_*.cache.json
!rigidity/sdattack_*.cache.json

